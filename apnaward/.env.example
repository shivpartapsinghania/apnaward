# Optional Gemini API key (server-side only; never expose in VITE_ variables)
GEMINI_API_KEY=
PORT=3000
APP_URL=http://localhost:3000

# Supabase public project configuration. The anon key is designed for client use;
# Row Level Security is mandatory. NEVER put a service_role key in this file.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
